# Copy to .env locally. Keep all secret values empty in tracked files.

# 1. Telegram Bot
TELEGRAM_BOT_TOKEN=
# Bot username (with or without @) for t.me deep links in customer broadcasts
# (e.g. the restock notification's "Open the bot" CTA). Optional.
TELEGRAM_BOT_USERNAME=

# 2. Database & Cache
# Supabase connection pooler URL (for runtime queries)
DATABASE_URL=
# Direct database connection without pooler (required for migrations / DDL)
DIRECT_URL=
REDIS_URL=

# 3. Upstream Partner API (XPro)
UPSTREAM_PARTNER_API_BASE_URL=http://paid2.daki.cc:4153/api/partner/v1
UPSTREAM_PARTNER_API_KEY=

# 3.1 Second Supplier: DigitalCore (Multi-Supplier Architecture)
DIGITALCORE_BASE_URL=https://digitalcore.top
DIGITALCORE_API_KEY=
SUPPLIERS_ENABLED=xpro

# 3.2 Automatic catalog sync (minutes between syncs; 0 disables the scheduler)
CATALOG_SYNC_INTERVAL_MINUTES=10
# 3.3 Supplier balance check cadence (low-balance alert latency, minutes; 0 disables)
BALANCE_CHECK_INTERVAL_MINUTES=2

# 4. Security & Encryption Secrets (Never use default values in production!)
DELIVERY_ENCRYPTION_KEY=
# Fastify reverse proxy trust: 1 for single-hop proxy (Render, Cloudflare, Nginx), or false to disable
TRUST_PROXY=1
# Allowed origins for CORS (comma-separated domains)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://admin.arenastore.mm

# 5. Admin Initial Setup
ADMIN_EMAIL=admin@arenastore.mm
ADMIN_INITIAL_PASSWORD=
# Admin 2FA (TOTP / Google Authenticator). Leave empty to disable. Generate
# with `pnpm totp:enroll`, then scan/print the setup key it produces.
ADMIN_TOTP_SECRET=

# 6. Telegram Channel Verification (Force Subscription)
REQUIRED_CHANNEL_USERNAME=@arenasellerstore
FORCE_CHANNEL_JOIN=true

# 6.1 Admin Deposit Slip Relay (optional env fallback — can also be set in the
# Admin Panel under Settings → Bot Operations; the DB value wins if set).
# Group Chat ID of the support group (super-group format: -100xxxxxxxxxx).
TELEGRAM_GROUP_CHAT_ID=
# Forum topic id (message_thread_id) of the "Deposit" topic; empty = General.
TELEGRAM_DEPOSIT_TOPIC_ID=
# Forum topic id (message_thread_id) of the "Bot Alert" topic where operational
# alerts (low supplier balance, config errors, upstream timeouts) are posted;
# empty = General.
TELEGRAM_BOT_ALERT_TOPIC_ID=
# Admin Telegram usernames to @mention at the bottom of each relayed deposit
# slip (so they get notified). Comma/space/pipe separated, e.g. ryanwez, H_M_A_2026
TELEGRAM_ADMIN_MENTIONS=
# Approver Telegram IDs or usernames allowed to click the Approve/Reject buttons
# in the admin group (comma/space separated, e.g. 123456789, ryanwez).
# Required: Empty = disabled (default-deny for security; approvals are rejected).
TELEGRAM_APPROVER_IDS=
# Base URL the bot calls the API at (deposit slip review buttons, order relay).
# Local dev default is http://localhost:4000. On a single Render web service
# hosting API + bot in one instance, point it at the loopback address with the
# API's PORT (Render injects PORT=10000 by default), e.g. http://127.0.0.1:10000
API_BASE_URL=
# Shared secret the bot uses to call internal API endpoints (deposit slip
# Approve/Reject buttons in the admin group). Must be identical in both
# processes; empty disables those endpoints.
INTERNAL_API_TOKEN=

# 7. Monitoring — Sentry (optional; leave empty to run with zero Sentry overhead)
# Error tracking for the API and the Telegram bot (runtime env)
SENTRY_DSN=
# Error tracking for the admin dashboard (Nuxt). Must be set at build time
# too — the Nuxt module is only wired when the DSN exists during the build.
NUXT_PUBLIC_SENTRY_DSN=

# 8. Bot Runtime Mode (optional — default is long polling)
# Set BOT_MODE=webhook to receive updates via Telegram webhook instead of
# getUpdates long polling. Requires a publicly reachable HTTPS URL.
BOT_MODE=
# Port the bot's webhook HTTP server listens on (default 3001; Render injects PORT)
BOT_PORT=3001
# Public HTTPS URL Telegram POSTs updates to — registered with setWebhook on boot.
# Empty in polling mode. Point it at the bot service's public URL.
BOT_WEBHOOK_URL=
# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token (recommended)
BOT_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 12. MyanMyanPay (MMPay) MMQR Gateway (Optional)
# ----------------------------------------------------------------------------
MMPAY_APP_ID=
MMPAY_PUBLISHABLE_KEY=
MMPAY_SECRET_KEY=
MMPAY_API_BASE_URL=https://bbapi.myanmyanpay.com
# Public base URL of this API. Used for TWO things:
#   1. Building the MMPay webhook callback URL (<PUBLIC_API_URL>/api/webhooks/mmpay).
#   2. The HTTPS `Origin` header on every production gateway call. The production
#      /xpayments/* endpoints REJECT any call without an https Origin (R0004
#      "Origin Requires SSL"), so in production this MUST be set to the live
#      https origin, e.g. https://arena.ryanwez.com. (Sandbox does not require it.)
PUBLIC_API_URL=
# Safety net for a webhook that is never delivered: how often (seconds) the API
# polls MyanMyanPay for still-PENDING MMQR orders and credits any it reports as
# paid. The credit is idempotent with the webhook, so the two can never
# double-credit. 0 disables the sweep; only runs when MMPay keys are set.
# Default 45.
MMPAY_RECONCILE_INTERVAL_SECONDS=45


