{
  "name": "arena-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:admin": "pnpm --filter @arena/admin dev",
    "dev:api": "pnpm --filter @arena/api dev",
    "dev:bot": "pnpm --filter @arena/bot dev",
    "totp:enroll": "node scripts/generate-totp.mjs",
    "test": "pnpm --filter @arena-store/tests test",
    "test:unit": "pnpm --filter @arena-store/tests test:unit",
    "test:integration": "pnpm --filter @arena-store/tests test:integration",
    "test:e2e": "pnpm --filter @arena-store/tests test:e2e",
    "build": "pnpm -r build",
    "start": "node scripts/start-all.mjs",
    "start:backend": "node scripts/start-all.mjs",
    "lint": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.2"
  }
}
