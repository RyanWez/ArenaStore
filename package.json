{
  "name": "arena-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:admin": "pnpm --filter @arena/admin dev",
    "dev:api": "pnpm --filter @arena/api dev",
    "dev:bot": "pnpm --filter @arena/bot dev",
    "test": "pnpm --filter @arena-store/tests test",
    "test:unit": "pnpm --filter @arena-store/tests test:unit",
    "test:integration": "pnpm --filter @arena-store/tests test:integration",
    "test:e2e": "pnpm --filter @arena-store/tests test:e2e",
    "build": "pnpm -r build",
    "start": "pnpm --filter @arena/api start & pnpm --filter @arena/bot start",
    "start:backend": "pnpm --filter @arena/api start & pnpm --filter @arena/bot start",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
